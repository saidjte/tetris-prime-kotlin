<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#7DE7FF" android:endColor="#0EA5C4" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#A5F3FC" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#22D3EE" android:endColor="#0E7C95" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#67E8F9" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
