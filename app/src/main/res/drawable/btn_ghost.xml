<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#475569" android:endColor="#1E293B" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#94A3B8" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#334155" android:endColor="#0F172A" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#64748B" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
