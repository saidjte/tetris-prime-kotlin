<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#FCA5A5" android:endColor="#991B1B" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#FECACA" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#F87171" android:endColor="#7F1D1D" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FCA5A5" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
