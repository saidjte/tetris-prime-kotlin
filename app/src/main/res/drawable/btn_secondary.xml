<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#C4B5FD" android:endColor="#6D28D9" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#DDD6FE" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#A78BFA" android:endColor="#5B21B6" android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#C4B5FD" />
            <padding android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
