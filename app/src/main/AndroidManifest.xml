<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 7: required for HapticController (vibration feedback on input) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.TetrisPrime"
        android:screenOrientation="portrait">

        <!-- Main entry point: Mode selection -->
        <activity
            android:name=".ModeSelectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Game activity -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Phase 6: UI screens -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AchievementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".LeaderboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Phase 7: Input customization -->
        <activity
            android:name=".InputSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Phase 8: Missions / Adventure / Gift codes -->
        <activity
            android:name=".MissionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AdventureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GiftCodeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Phase 9: Language picker -->
        <activity
            android:name=".LanguageSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Phase 10: Backup & restore -->
        <activity
            android:name=".BackupRestoreActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
