<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 7: required for HapticController (vibration feedback on input) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phase 0: AdMob + GiftBridge (network) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Phase 0: AdMob privacy-sandbox permissions (API 33+) -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" />

    <application
        android:name=".TetrisApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.TetrisPrime"
        android:screenOrientation="fullUser"
        android:usesCleartextTraffic="false">

        <!-- Phase 0: AdMob app id (ca-app-pub-1782722148244932~1950528375) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1782722148244932~1950528375" />

        <!-- Phase 0: delay AdMob init until first ad request -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- Main entry point: Mode selection.
             configChanges mirrors the original app — prevents Activity
             recreation on rotation/density/uiMode changes (Android handles
             the rotation via JS-side settings.allowRotation). -->
        <activity
            android:name=".ModeSelectActivity"
            android:exported="true"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Game activity -->
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 6: UI screens -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".AchievementsActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".StoreActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".TutorialActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".LeaderboardActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 7: Input customization -->
        <activity
            android:name=".InputSettingsActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 8: Missions / Adventure / Gift codes -->
        <activity
            android:name=".MissionsActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".AdventureActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".GiftCodeActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 9: Language picker -->
        <activity
            android:name=".LanguageSettingsActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 10: Backup & restore -->
        <activity
            android:name=".BackupRestoreActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 11: Performance profiles -->
        <activity
            android:name=".PerformanceProfileActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser" />

        <!-- Phase 0: AdMob AdActivity (required by Google Mobile Ads SDK) -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Translucent" />
    </application>

</manifest>
